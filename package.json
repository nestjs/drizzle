{
  "name": "@nestjs/drizzle",
  "version": "0.0.1",
  "description": "Nest - modern, fast, powerful node.js web framework (@drizzle)",
  "author": "Kamil Mysliwiec",
  "license": "MIT",
  "url": "https://github.com/nestjs/drizzle#readme",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "format": "prettier --write \"**/*.ts\"",
    "lint": "oxlint lib/",
    "prepublish:npm": "npm run build",
    "publish:npm": "npm publish --access public",
    "prepublish:next": "npm run build",
    "publish:next": "npm publish --access public --tag next",
    "test:e2e": "vitest run",
    "test:e2e:dev": "vitest",
    "prerelease": "npm run build",
    "release": "release-it",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-angular": "21.2.3",
    "@electric-sql/pglite": "0.5.8",
    "@libsql/client": "0.18.0",
    "@nestjs/common": "12.1.0",
    "@nestjs/core": "12.0.4",
    "@nestjs/platform-express": "12.1.0",
    "@nestjs/testing": "12.0.4",
    "@types/node": "24.19.0",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "drizzle-orm": "0.45.3",
    "husky": "9.1.7",
    "lint-staged": "17.5.1",
    "mysql2": "3.24.4",
    "oxlint": "1.85.0",
    "pg": "8.23.0",
    "postgres": "3.4.9",
    "prettier": "3.9.9",
    "reflect-metadata": "0.2.2",
    "release-it": "21.1.0",
    "rxjs": "7.8.2",
    "supertest": "7.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0 || ^12.0.0",
    "@nestjs/core": "^11.0.0 || ^12.0.0",
    "drizzle-orm": ">=0.35.0 || >=1.0.0-0",
    "reflect-metadata": "^0.1.13 || ^0.2.0"
  },
  "lint-staged": {
    "**/*.{ts,json}": []
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nestjs/drizzle"
  }
}
